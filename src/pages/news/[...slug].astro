---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticleIndex, getRelated, readingTimeOf } from '../../utils/articles';

export async function getStaticPaths() {
  const { all } = await getArticleIndex();
  return all.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, pubDate, description, category, heroImage, sentiment, sourceUrl, tags } = article.data;

const index = await getArticleIndex();
const readingTime = readingTimeOf(index, article);

// Related articles: same category, excluding current, sorted by tag overlap then date
const related = getRelated(index, article);
---

<ArticleLayout
  title={title}
  description={description}
  pubDate={pubDate}
  country=""
  countryCode=""
  category={category}
  heroImage={heroImage}
  sentiment={sentiment}
  sourceUrl={sourceUrl}
  readingTime={readingTime}
  tags={tags}
>
  <Content />

  <Fragment slot="after-article">
    {related.length > 0 && (
      <section class="max-w-6xl mx-auto px-6 pb-16 pt-10">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-muted)]">Related stories</h2>
          <div class="flex-1 h-px bg-[var(--color-border)]"></div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {related.map((r) => (
            <ArticleCard
              id={r.id}
              slug={r.id}
              readingTime={readingTimeOf(index, r)}
              {...r.data}
            />
          ))}
        </div>
      </section>
    )}
  </Fragment>
</ArticleLayout>
